      "sql": "WITH monthly AS (\n  SELECT\n    branch_name,\n    date_trunc('month', report_month)::date AS month,\n    SUM(revenue_usd) AS revenue_usd\n  FROM public.branch_finance_kpis\n  GROUP BY branch_name, date_trunc('month', report_month)\n)\nSELECT\n  branch_name,\n  month AS report_month,\n  revenue_usd,\n  LAG(revenue_usd) OVER (PARTITION BY branch_name ORDER BY month) AS prev_revenue_usd,\n  ROUND(\n    CASE WHEN LAG(revenue_usd) OVER (PARTITION BY branch_name ORDER BY month) IS NULL THEN NULL\n         WHEN LAG(revenue_usd) OVER (PARTITION BY branch_name ORDER BY month) = 0 THEN NULL\n         ELSE (revenue_usd - LAG(revenue_usd) OVER (PARTITION BY branch_name ORDER BY month))\n              / LAG(revenue_usd) OVER (PARTITION BY branch_name ORDER BY month) * 100\n    END\n  ,2) AS revenue_growth_pct\nFROM monthly\nORDER BY branch_name, month\nLIMIT 200;",
      "saved_at": "2026-03-19T00:07:40.492394"
