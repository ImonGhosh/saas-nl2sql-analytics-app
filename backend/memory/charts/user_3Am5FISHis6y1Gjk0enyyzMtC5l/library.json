      "sql": "SELECT\n  region,\n  SUM(net_profit_usd) AS total_net_profit_usd,\n  SUM(revenue_usd) AS total_revenue_usd,\n  CASE WHEN SUM(revenue_usd) = 0 THEN NULL ELSE SUM(net_profit_usd) / NULLIF(SUM(revenue_usd),0) END AS net_profit_margin,\n  SUM(operating_expense_usd) AS total_operating_expense_usd,\n  AVG(operating_expense_usd) AS avg_operating_expense_usd,\n  COUNT(DISTINCT branch_name) AS branch_count\nFROM public.branch_finance_kpis\nWHERE region IS NOT NULL\nGROUP BY region\nORDER BY net_profit_margin DESC NULLS LAST\nLIMIT 200;",
