      ],
      "sql": "WITH latest AS (\n  SELECT max(report_month) AS max_month FROM public.branch_finance_kpis\n),\nfiltered AS (\n  SELECT * FROM public.branch_finance_kpis, latest\n  WHERE report_month >= (latest.max_month - INTERVAL '11 months')\n    AND avg_transaction_value_usd IS NOT NULL\n)\nSELECT branch_name,\n       COUNT(*) AS periods,\n       ROUND(AVG(avg_transaction_value_usd)::numeric, 2) AS avg_transaction_value_usd\nFROM filtered\nGROUP BY branch_name\nORDER BY avg_transaction_value_usd DESC\nLIMIT 200;",
      "saved_at": "2026-03-19T00:08:51.959175"
