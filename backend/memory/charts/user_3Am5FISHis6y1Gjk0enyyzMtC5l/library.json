      "sql": "WITH monthly AS (\n  SELECT\n    report_month::date AS month,\n    region,\n    SUM(customer_accounts) AS customer_accounts\n  FROM public.branch_finance_kpis\n  WHERE report_month >= date_trunc('month', current_date) - interval '36 months'\n  GROUP BY report_month, region\n)\nSELECT\n  month,\n  region,\n  customer_accounts,\n  LAG(customer_accounts) OVER (PARTITION BY region ORDER BY month) AS prev_customer_accounts,\n  ROUND(\n    CASE WHEN LAG(customer_accounts) OVER (PARTITION BY region ORDER BY month) IS NULL THEN NULL\n         WHEN LAG(customer_accounts) OVER (PARTITION BY region ORDER BY month) = 0 THEN NULL\n         ELSE (customer_accounts - LAG(customer_accounts) OVER (PARTITION BY region ORDER BY month))::numeric\n              / LAG(customer_accounts) OVER (PARTITION BY region ORDER BY month) * 100\n    END\n  , 2) AS mom_growth_pct\nFROM monthly\nORDER BY region, month\nLIMIT 200;",
      "saved_at": "2026-03-20T01:02:25.677602"
