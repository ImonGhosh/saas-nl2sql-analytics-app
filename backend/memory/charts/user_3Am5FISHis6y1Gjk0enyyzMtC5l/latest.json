  "sql": "WITH monthly AS (\n  SELECT\n    branch_name,\n    date_trunc('month', report_month)::date AS month,\n    SUM(revenue_usd) AS revenue_usd\n  FROM public.branch_finance_kpis\n  GROUP BY branch_name, date_trunc('month', report_month)\n),\nranked AS (\n  SELECT\n    branch_name,\n    month,\n    revenue_usd,\n    LAG(revenue_usd) OVER (PARTITION BY branch_name ORDER BY month) AS prev_revenue_usd\n  FROM monthly\n)\nSELECT\n  branch_name,\n  month AS report_month,\n  revenue_usd,\n  prev_revenue_usd,\n  CASE\n    WHEN prev_revenue_usd IS NULL OR prev_revenue_usd = 0 THEN NULL\n    ELSE ROUND((revenue_usd - prev_revenue_usd) / prev_revenue_usd * 100.0, 4)\n  END AS revenue_growth_pct\nFROM ranked\nORDER BY branch_name, month\nLIMIT 200;"
}