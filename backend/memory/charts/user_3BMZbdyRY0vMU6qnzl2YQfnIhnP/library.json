      ],
      "sql": "SELECT COALESCE(sales_channel,'Unknown') AS sales_channel,\n       COUNT(*) AS orders_count,\n       SUM(gross_order_amount) AS gross_revenue,\n       SUM(net_order_amount) AS net_revenue,\n       SUM(gross_order_amount - net_order_amount) AS discount_amount,\n       CASE WHEN SUM(gross_order_amount) = 0 THEN 0\n            ELSE ROUND(100.0 * SUM(gross_order_amount - net_order_amount) / SUM(gross_order_amount), 2)\n       END AS discount_pct\nFROM public.sales_orders\nGROUP BY COALESCE(sales_channel,'Unknown')\nORDER BY gross_revenue DESC\nLIMIT 200;",
